# Logs
logs
*.log
npm-debug.log*

# Dependencies
node_modules
dist
dist-ssr
dev-dist
*.local

# Env (never commit secrets; the AI-broker Claude key lives server-side, not here)
.env
.env.*
!.env.example

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Build info
node_modules/.tmp

# In-app dev feedback batches — transient working artifacts, not history.
# Keep the folders and README, ignore the batch files themselves.
feedback/incoming/*
feedback/processed/*
!feedback/incoming/.gitkeep
!feedback/processed/.gitkeep

# Pull config holds the live web-app URL + token — local only.
feedback/.pull.json
