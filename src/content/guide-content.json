{
  "version": "1.0.0",
  "title": "Local Genres Research for Psalms Translation",
  "sections": [
    {
      "id": "s0",
      "type": "group",
      "label": "Section 0: The Psalm",
      "children": [
        {
          "id": "s0.purpose",
          "type": "group",
          "label": "Psalm Purpose",
          "layer": "focusText",
          "minDepth": "quick",
          "guidance": "Complete only these purpose questions before moving to Section 1. Return here throughout the process to summarize what you learn.",
          "children": [
            {
              "id": "s0.purpose.specific",
              "type": "long_text",
              "label": "Specific purpose of the psalm (gives some idea of specific content)",
              "layer": "focusText",
              "minDepth": "quick"
            },
            {
              "id": "s0.purpose.general",
              "type": "short_text",
              "label": "General purpose: the primary speech act (e.g. to teach, to encourage, to mourn)",
              "layer": "focusText",
              "minDepth": "quick"
            },
            {
              "id": "s0.purpose.broad_genre",
              "type": "single_select",
              "label": "Broad biblical genre",
              "layer": "focusText",
              "minDepth": "quick",
              "options": [
                { "id": "wisdom", "label": "Wisdom" },
                { "id": "lament", "label": "Lament" },
                { "id": "praise", "label": "Praise" },
                { "id": "thanksgiving", "label": "Thanksgiving" },
                { "id": "royal", "label": "Royal" },
                { "id": "trust", "label": "Trust" },
                { "id": "other", "label": "Other" }
              ]
            },
            {
              "id": "s0.purpose.intended_use",
              "type": "long_text",
              "label": "How is the translation intended to be used? For what social context? (singing, listening, reading, passive participation, active participation, etc.)",
              "layer": "focusText",
              "minDepth": "quick"
            }
          ]
        },
        {
          "id": "s0.genre_choice",
          "type": "group",
          "label": "Psalm Genre Choice",
          "layer": "synthesis",
          "minDepth": "quick",
          "guidance": "Use your 1B chart to identify up to 3 workable genres. Note any potentially problematic social features or associations, and a strategy to address them.",
          "children": [
            {
              "id": "s0.genre_choice.candidates",
              "type": "repeatable_row_table",
              "label": "Candidate genres for this psalm",
              "layer": "synthesis",
              "minDepth": "quick",
              "xref": [{ "to": "s1b.inventory", "relation": "derivedFrom", "label": "from your 1B chart" }],
              "columns": [
                { "id": "name", "label": "Genre", "cellType": "short_text", "minDepth": "quick" },
                { "id": "why", "label": "Why does it work well?", "cellType": "long_text", "minDepth": "quick" },
                { "id": "concerns", "label": "Problematic social features or associations?", "cellType": "long_text", "minDepth": "standard" },
                { "id": "strategy", "label": "Strategy to alleviate concerns", "cellType": "long_text", "minDepth": "standard" }
              ]
            },
            {
              "id": "s0.genre_choice.chosen",
              "type": "short_text",
              "label": "Which genre will the team pursue analyzing for this psalm?",
              "layer": "synthesis",
              "minDepth": "quick"
            }
          ]
        },
        {
          "id": "s0.macro_notes",
          "type": "group",
          "label": "Psalm Macro-Level Translation Notes",
          "layer": "synthesis",
          "minDepth": "standard",
          "guidance": "Summarize Section 2 and connect it to your psalm.",
          "children": [
            {
              "id": "s0.macro_notes.prominence",
              "type": "fixed_grid",
              "label": "Prominence",
              "layer": "synthesis",
              "minDepth": "standard",
              "xref": [{ "to": "s2a", "relation": "derivedFrom", "label": "from 2A" }],
              "rows": [
                { "id": "primary", "label": "Primary" },
                { "id": "secondary", "label": "Secondary" },
                { "id": "additional", "label": "Additional" }
              ],
              "columns": [
                { "id": "psalm", "label": "What the psalm communicates", "cellType": "long_text", "minDepth": "standard" },
                { "id": "genre_strategy", "label": "Genre strategy for prominence", "cellType": "long_text", "minDepth": "standard" },
                { "id": "translation_idea", "label": "Idea for the translation", "cellType": "long_text", "minDepth": "standard" }
              ]
            },
            {
              "id": "s0.macro_notes.sections",
              "type": "repeatable_row_table",
              "label": "Sections",
              "layer": "synthesis",
              "minDepth": "standard",
              "xref": [{ "to": "s2b", "relation": "derivedFrom", "label": "from 2B" }],
              "columns": [
                { "id": "psalm_section", "label": "Psalm section", "cellType": "short_text", "minDepth": "standard" },
                { "id": "genre_section", "label": "Genre section", "cellType": "short_text", "minDepth": "standard" },
                { "id": "shift_notes", "label": "Notes on section shifts (for this psalm)", "cellType": "long_text", "minDepth": "comprehensive" },
                { "id": "genre_features", "label": "Specific genre feature notes", "cellType": "long_text", "minDepth": "comprehensive" },
                { "id": "psalm_features", "label": "Specific psalm feature notes + rendering ideas", "cellType": "long_text", "minDepth": "comprehensive" }
              ]
            },
            {
              "id": "s0.macro_notes.emotions",
              "type": "repeatable_row_table",
              "label": "Emotions",
              "layer": "synthesis",
              "minDepth": "standard",
              "guidance": "Aim for 3-5, listed in approximate order. Group separate occurrences of the same emotion in one row.",
              "xref": [{ "to": "s2c", "relation": "derivedFrom", "label": "from 2C" }],
              "columns": [
                { "id": "emotion", "label": "Emotion + where (verse/section)", "cellType": "short_text", "minDepth": "standard" },
                { "id": "genre_elements", "label": "How to communicate it with genre-appropriate elements", "cellType": "long_text", "minDepth": "standard" }
              ]
            },
            {
              "id": "s0.macro_notes.connections",
              "type": "repeatable_row_table",
              "label": "Connections",
              "layer": "synthesis",
              "minDepth": "standard",
              "guidance": "Try to identify at least 3 connections between words, phrases, sections, or other elements.",
              "xref": [{ "to": "s2d", "relation": "derivedFrom", "label": "from 2D" }],
              "columns": [
                { "id": "connection", "label": "Connection made in the psalm", "cellType": "long_text", "minDepth": "standard" },
                { "id": "genre_elements", "label": "Idea for showing it with genre-appropriate elements", "cellType": "long_text", "minDepth": "standard" }
              ]
            }
          ]
        },
        {
          "id": "s0.stylistic_notes",
          "type": "group",
          "label": "Psalm Stylistic Analysis Translation Notes",
          "layer": "synthesis",
          "minDepth": "standard",
          "guidance": "For each category note 3-5 distinctive features and mark the 1-2 highest priority to carry into the translation, with ideas for how to incorporate them.",
          "children": [
            {
              "id": "s0.sn.words",
              "type": "repeatable_row_table",
              "label": "Words (3A)",
              "layer": "synthesis",
              "minDepth": "standard",
              "priorityEligible": true,
              "priorityMax": 2,
              "columns": [
                { "id": "feature", "label": "Feature observation", "cellType": "long_text", "minDepth": "standard" },
                { "id": "idea", "label": "Idea for translation in focus psalm", "cellType": "long_text", "minDepth": "standard" }
              ]
            },
            {
              "id": "s0.sn.discourse",
              "type": "repeatable_row_table",
              "label": "Discourse (3B)",
              "layer": "synthesis",
              "minDepth": "standard",
              "priorityEligible": true,
              "priorityMax": 2,
              "columns": [
                { "id": "feature", "label": "Feature observation", "cellType": "long_text", "minDepth": "standard" },
                { "id": "idea", "label": "Idea for translation in focus psalm", "cellType": "long_text", "minDepth": "standard" }
              ]
            },
            {
              "id": "s0.sn.sounds",
              "type": "repeatable_row_table",
              "label": "Sounds (3C)",
              "layer": "synthesis",
              "minDepth": "standard",
              "priorityEligible": true,
              "priorityMax": 2,
              "columns": [
                { "id": "feature", "label": "Feature observation", "cellType": "long_text", "minDepth": "standard" },
                { "id": "idea", "label": "Idea for translation in focus psalm", "cellType": "long_text", "minDepth": "standard" }
              ]
            },
            {
              "id": "s0.sn.figurative",
              "type": "repeatable_row_table",
              "label": "Figurative language (3D)",
              "layer": "synthesis",
              "minDepth": "standard",
              "priorityEligible": true,
              "priorityMax": 2,
              "columns": [
                { "id": "feature", "label": "Feature observation", "cellType": "long_text", "minDepth": "standard" },
                { "id": "idea", "label": "Idea for translation in focus psalm", "cellType": "long_text", "minDepth": "standard" }
              ]
            },
            {
              "id": "s0.sn.performance",
              "type": "repeatable_row_table",
              "label": "Performance (3E)",
              "layer": "synthesis",
              "minDepth": "standard",
              "priorityEligible": true,
              "priorityMax": 2,
              "columns": [
                { "id": "feature", "label": "Feature observation", "cellType": "long_text", "minDepth": "standard" },
                { "id": "idea", "label": "Idea for translation in focus psalm", "cellType": "long_text", "minDepth": "standard" }
              ]
            },
            {
              "id": "s0.sn.additional",
              "type": "repeatable_row_table",
              "label": "Additional (3F)",
              "layer": "synthesis",
              "minDepth": "comprehensive",
              "priorityEligible": true,
              "priorityMax": 2,
              "columns": [
                { "id": "feature", "label": "Feature observation", "cellType": "long_text", "minDepth": "comprehensive" },
                { "id": "idea", "label": "Idea for translation in focus psalm", "cellType": "long_text", "minDepth": "comprehensive" }
              ]
            }
          ]
        },
        {
          "id": "s0.translation",
          "type": "group",
          "label": "Psalm Translation",
          "layer": "synthesis",
          "minDepth": "quick",
          "children": [
            {
              "id": "s0.translation.intro",
              "type": "prose",
              "label": "You're ready to create the translation. Keep prayer part of the process, and include people who enjoy creating in this genre. Let your notes above guide you."
            },
            {
              "id": "s0.translation.draft",
              "type": "long_text",
              "label": "Translation draft and notes",
              "layer": "synthesis",
              "minDepth": "quick"
            }
          ]
        }
      ]
    },
    {
      "id": "s1",
      "type": "group",
      "label": "Section 1: Ethnographic Analysis of Genres",
      "children": [
        {
          "id": "s1a",
          "type": "group",
          "label": "1A: Finding Genres",
          "layer": "focusText",
          "children": [
            {
              "id": "s1a.intro",
              "type": "prose",
              "label": "List communication forms (genres) in the culture. They must be understood, appreciated, creatable, and feasible for members of the culture to use in the intended manner (listening, singing, reading, performing)."
            },
            {
              "id": "s1a.scope",
              "type": "single_select",
              "label": "Scope of this search",
              "layer": "focusText",
              "minDepth": "standard",
              "options": [
                { "id": "narrow", "label": "Narrow (genres matching this psalm's purpose)" },
                { "id": "narrower", "label": "Narrower (a specific end product, e.g. a song or poem)" },
                { "id": "broad", "label": "Broad (build a foundation for future psalms)" }
              ]
            },
            {
              "id": "s1a.inventory",
              "type": "repeatable_list",
              "label": "Genres identified so far",
              "layer": "focusText",
              "minDepth": "quick"
            },
            {
              "id": "s1a.whom",
              "type": "repeatable_list",
              "label": "Whom to ask (leaders, teachers, creators, mothers, etc.)",
              "layer": "focusText",
              "minDepth": "standard"
            },
            {
              "id": "s1a.where",
              "type": "repeatable_list",
              "label": "When and where to ask (celebrations, festivals/holidays, social gatherings, social media, etc.)",
              "layer": "focusText",
              "minDepth": "comprehensive"
            },
            {
              "id": "s1a.questions",
              "type": "repeatable_list",
              "label": "Questions to ask (life-cycle events, celebrations, uses of voice/instruments/body/colors)",
              "layer": "focusText",
              "minDepth": "comprehensive"
            }
          ]
        },
        {
          "id": "s1b",
          "type": "group",
          "label": "1B: Genre Social Features",
          "layer": "genre",
          "guidance": "Each row is a genre, reused across psalms. Quick mode shows Genre, Who, and Vitality; more columns appear at greater depth.",
          "children": [
            {
              "id": "s1b.inventory",
              "type": "repeatable_row_table",
              "label": "Genre social-feature inventory",
              "layer": "genre",
              "minDepth": "quick",
              "columns": [
                { "id": "genreName", "label": "Genre (name + meaning, any wordplay)", "cellType": "short_text", "minDepth": "quick" },
                { "id": "who", "label": "Who is involved (hierarchy, gender, age, status/roles)", "cellType": "long_text", "minDepth": "quick" },
                { "id": "when", "label": "When performed (year, day, life/community events, cycles)", "cellType": "long_text", "minDepth": "standard" },
                { "id": "where", "label": "Where performed (specific/prepared/improvised space)", "cellType": "long_text", "minDepth": "standard" },
                { "id": "materials", "label": "Materials (instruments, props, visuals, equipment)", "cellType": "long_text", "minDepth": "standard" },
                { "id": "content", "label": "Content (purpose, leisure/ceremony, spontaneous/planned, topics)", "cellType": "long_text", "minDepth": "comprehensive" },
                { "id": "associations", "label": "Associations (other art forms, religious/political/cultural)", "cellType": "long_text", "minDepth": "comprehensive" },
                {
                  "id": "vitality",
                  "label": "Vitality (community attachment, future use, new works)",
                  "cellType": "single_select",
                  "minDepth": "quick",
                  "options": [
                    { "id": "weak", "label": "Weak" },
                    { "id": "neutral", "label": "Neutral" },
                    { "id": "strong", "label": "Strong" }
                  ]
                },
                { "id": "other", "label": "Other notes", "cellType": "long_text", "minDepth": "comprehensive" }
              ]
            }
          ]
        },
        {
          "id": "s1c",
          "type": "group",
          "label": "1C: Matching Psalm and Genres",
          "layer": "focusText",
          "children": [
            {
              "id": "s1c.notes",
              "type": "long_text",
              "label": "Which genre(s) suit this psalm's purpose and content? What works well, what social features or associations might be problematic, and what strategies could address concerns? (Record final choices in Psalm Genre Choice.)",
              "layer": "focusText",
              "minDepth": "quick",
              "xref": [{ "to": "s0.genre_choice", "relation": "feeds", "label": "record in Genre Choice" }]
            }
          ]
        }
      ]
    },
    {
      "id": "s2",
      "type": "group",
      "label": "Section 2: Macro-Level Analysis",
      "children": [
        {
          "id": "s2a",
          "type": "group",
          "label": "2A: Prominence in this Genre",
          "layer": "genre",
          "children": [
            {
              "id": "s2a.how",
              "type": "long_text",
              "label": "How does this genre generally highlight the most prominent material? (position/refrain/punch line, repetition, contrast or breaking a pattern, something unexpected, clustering of intense features, intensity of emotion, density of thematic content, other)",
              "layer": "genre",
              "minDepth": "quick"
            },
            {
              "id": "s2a.secondary",
              "type": "long_text",
              "label": "How does this genre feature secondary prominence?",
              "layer": "genre",
              "minDepth": "standard"
            },
            {
              "id": "s2a.climax",
              "type": "long_text",
              "label": "Which features tend to mark the climax of the genre?",
              "layer": "genre",
              "minDepth": "standard"
            },
            {
              "id": "s2a.peak",
              "type": "long_text",
              "label": "How might the genre present an aesthetic peak that sets people up for the 'take-home' moment (the point of the experience)?",
              "layer": "genre",
              "minDepth": "comprehensive",
              "footnote": "E.g. the aesthetic marking in the middle verse of Psalm 67 (sole tricolon, center of a chiasm, center of 7 people-group words) sets up the punch line about the ends of the earth fearing God."
            }
          ]
        },
        {
          "id": "s2b",
          "type": "group",
          "label": "2B: Sections in this Genre",
          "layer": "genre",
          "children": [
            {
              "id": "s2b.organization",
              "type": "long_text",
              "label": "How is information organized in the genre? What's the expected progression of content?",
              "layer": "genre",
              "minDepth": "quick"
            },
            {
              "id": "s2b.major_sections",
              "type": "long_text",
              "label": "What are the major internal sections? (how many; predictable elements, length, content, function, order; any other predictable features)",
              "layer": "genre",
              "minDepth": "standard"
            },
            {
              "id": "s2b.relationships",
              "type": "long_text",
              "label": "How are the sections related to one another? (repeated, contrastive, derivative/varied units)",
              "layer": "genre",
              "minDepth": "standard"
            },
            {
              "id": "s2b.music",
              "type": "long_text",
              "label": "If music is involved, how do the sections correspond with musical function (same/different melody per line, predictable musical climax, etc.)?",
              "layer": "genre",
              "minDepth": "comprehensive"
            },
            {
              "id": "s2b.roles",
              "type": "long_text",
              "label": "If different performers or characters are involved, which roles connect with which lines/sections?",
              "layer": "genre",
              "minDepth": "comprehensive"
            },
            {
              "id": "s2b.shifts",
              "type": "long_text",
              "label": "What signals a shift between sections? (content, mood, rhythm/sound, visuals, speaker/addressee/character changes, materials, language/poetic devices, vocal features/gestures)",
              "layer": "genre",
              "minDepth": "standard"
            },
            {
              "id": "s2b.bme",
              "type": "long_text",
              "label": "What predictable elements characterize beginnings, middles, and ends of an instance of the genre and of specific sections?",
              "layer": "genre",
              "minDepth": "comprehensive"
            }
          ]
        },
        {
          "id": "s2c",
          "type": "group",
          "label": "2C: Emotions in this Genre",
          "layer": "genre",
          "children": [
            {
              "id": "s2c.which",
              "type": "long_text",
              "label": "What emotions generally appear in this genre?",
              "layer": "genre",
              "minDepth": "quick"
            },
            {
              "id": "s2c.chart",
              "type": "repeatable_row_table",
              "label": "How are specific emotions represented? (one row per emotion)",
              "layer": "genre",
              "minDepth": "standard",
              "columns": [
                { "id": "emotion", "label": "Emotion", "cellType": "short_text", "minDepth": "standard" },
                { "id": "materials", "label": "Instruments, props, or other materials", "cellType": "long_text", "minDepth": "standard" },
                { "id": "concepts", "label": "Concepts, figurative language, imagery", "cellType": "long_text", "minDepth": "standard" },
                { "id": "visuals", "label": "Visuals (patterns, colors)", "cellType": "long_text", "minDepth": "comprehensive" },
                { "id": "physical", "label": "Physical (gestures, expressions)", "cellType": "long_text", "minDepth": "comprehensive" },
                { "id": "rhythms", "label": "Meters, rhythms, sound patterns", "cellType": "long_text", "minDepth": "comprehensive" },
                { "id": "vocal", "label": "Vocal features (tone, tempo, volume)", "cellType": "long_text", "minDepth": "comprehensive" },
                { "id": "other", "label": "Other strategies", "cellType": "long_text", "minDepth": "comprehensive" }
              ]
            },
            {
              "id": "s2c.dependence",
              "type": "long_text",
              "label": "How much does understanding the emotions depend on the words themselves vs. other features (tone of voice, etc.)?",
              "layer": "genre",
              "minDepth": "comprehensive"
            }
          ]
        },
        {
          "id": "s2d",
          "type": "group",
          "label": "2D: Connections in this Genre",
          "layer": "genre",
          "children": [
            {
              "id": "s2d.chart",
              "type": "fixed_grid",
              "label": "How can this genre help the audience connect related information?",
              "layer": "genre",
              "minDepth": "standard",
              "rows": [
                { "id": "words", "label": "Related words" },
                { "id": "phrases", "label": "Related phrases" },
                { "id": "sections", "label": "Related sections" },
                { "id": "concepts", "label": "Related concepts" },
                { "id": "other", "label": "Other related material" }
              ],
              "columns": [
                { "id": "sounds", "label": "Sounds (instruments, vocal features, sound play)", "cellType": "long_text", "minDepth": "standard" },
                { "id": "structural", "label": "Structural position (parallel verses/lines)", "cellType": "long_text", "minDepth": "standard" },
                { "id": "visual", "label": "Visual elements (colors, flags, props)", "cellType": "long_text", "minDepth": "comprehensive" },
                { "id": "physical", "label": "Physical elements (gestures, expressions)", "cellType": "long_text", "minDepth": "comprehensive" },
                { "id": "linguistic", "label": "Linguistic strategies (related roots, grammatical forms)", "cellType": "long_text", "minDepth": "comprehensive" }
              ]
            }
          ]
        },
        {
          "id": "s2e",
          "type": "group",
          "label": "2E: Macro-Level Translation Choices",
          "layer": "genre",
          "children": [
            {
              "id": "s2e.intro",
              "type": "prose",
              "label": "Summarize what you learned about the macro considerations in the Psalm Macro-Level Translation Notes (Section 0)."
            }
          ]
        }
      ]
    },
    {
      "id": "s3",
      "type": "group",
      "label": "Section 3: Stylistic Elements Analysis",
      "children": [
        {
          "id": "s3a",
          "type": "group",
          "label": "3A: Word Use in this Genre",
          "layer": "genre",
          "children": [
            {
              "id": "s3a.expected",
              "type": "long_text",
              "label": "Which words, formulas, or motifs (e.g. 'better X than Y') are expected, and in which positions? Which words or word-positions (e.g. anaphora) are repeated? Any special use of negatives, pronouns, or names?",
              "layer": "genre",
              "minDepth": "quick"
            },
            {
              "id": "s3a.wordplay",
              "type": "long_text",
              "label": "What word play consistently appears? (homonyms, homophones, homographs, puns, oxymoron, irony, juxtaposition)",
              "layer": "genre",
              "minDepth": "standard"
            },
            {
              "id": "s3a.language",
              "type": "long_text",
              "label": "Expected language choices? (dialects/accents, register high/standard/low, specialized vs regular vocabulary, borrowed words, archaic words, frequency of less common words)",
              "layer": "genre",
              "minDepth": "standard"
            },
            {
              "id": "s3a.constructions",
              "type": "long_text",
              "label": "Special constructions? (parallelism/synonyms, enjambment, rhetorical questions, caesura, ellipsis)",
              "layer": "genre",
              "minDepth": "comprehensive"
            },
            {
              "id": "s3a.features",
              "type": "repeatable_row_table",
              "label": "Distinctive word-use features to carry forward",
              "layer": "genre",
              "minDepth": "standard",
              "priorityEligible": true,
              "priorityMax": 2,
