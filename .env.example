# Genre Research App environment.
#
# The app runs LOCAL-ONLY with none of these set: capture, the worksheet,
# depth modes, resume, and (later) CSV/Sheets export all work offline.
# These are only needed once the AI broker (build-order step 7) is wired up.

# Supabase (AI broker only for the MVP; project data stays local in IndexedDB).
# Reuse cairn's project or a sibling project (open item to decide).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cost guardrail for the future Claude broker Edge Function (server-side).
# The Claude API key itself lives in the Edge Function, never in this client.
CLAUDE_MONTHLY_SPEND_CAP_USD=50

# Google Sheets export (optional). A Google OAuth client id (Web application)
# with the drive.file scope. With this set, the Export screen can push a
# tab-per-section workbook to the user's Drive via client-side GIS. Leave blank
# to keep the offline CSV / AI-prompt exports only.
VITE_GOOGLE_CLIENT_ID=

# AI routing via GitHub (optional, automated path). "owner/repo" of a PRIVATE
# repo where captured notes are exchanged with Claude (Max). With this set, the
# AI routing screen can push notes and pull Claude's placements automatically;
# the GitHub token is entered in-app and stored on-device only (never in env).
# Leave blank to use the token-free copy/paste routing path.
VITE_ROUTING_REPO=
VITE_ROUTING_BRANCH=main
